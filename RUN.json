{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "go",
      "kind": "server",
      "start": ["go", "run", "."],
      "port": 8080,
      "port_env": "PORT",
      "health": { "path": "/healthz", "expect_status": [200] },
      "env": {
        "PORT": { "dev": "8080" },
        "HOST": { "dev": "127.0.0.1" },
        "FLAG_API_KEY": { "generate": "hex", "bytes": 32 }
      }
    }
  ]
}
